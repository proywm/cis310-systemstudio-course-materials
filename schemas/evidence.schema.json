{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemstudio.example/schemas/evidence.schema.json",
  "title": "SystemStudio AI Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "coursePack",
    "toolVersions",
    "observations",
    "redaction"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "runId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "coursePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "category", "status", "summary"],
        "properties": {
          "id": { "type": "string" },
          "source": { "enum": ["environment", "compiler", "linker", "test", "runtime", "simulator", "rule"] },
          "category": { "type": "string" },
          "status": { "enum": ["pass", "fail", "warning", "unknown", "infrastructure-error"] },
          "summary": { "type": "string" },
          "expected": {},
          "observed": {},
          "conceptIds": { "type": "array", "items": { "type": "string" } },
          "rubricIds": { "type": "array", "items": { "type": "string" } },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "relativePath": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "componentId": { "type": "string" },
              "signalId": { "type": "string" },
              "cycle": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "rulesVersion"],
      "properties": {
        "applied": { "type": "boolean" },
        "rulesVersion": { "type": "string" },
        "removedFields": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
