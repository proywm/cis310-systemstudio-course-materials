{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://systemstudio.example/schemas/course-pack.schema.json",
  "title": "SystemStudio AI Course Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "course",
    "activity",
    "objectives",
    "environment",
    "operations",
    "resources",
    "lessons",
    "hintPolicy"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title"],
      "properties": {
        "code": { "type": "string" },
        "title": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/identifiedText" }
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifiedText" }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["devContainer", "supportedPlatforms"],
      "properties": {
        "devContainer": { "type": "string" },
        "imageDigest": { "type": "string" },
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["windows", "macos", "linux", "remote"] }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "executable", "args", "timeoutSeconds"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "executable": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "workingDirectory": { "type": "string" },
          "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
          "network": { "enum": ["disabled", "restricted", "enabled"] }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "uri", "sha256"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "uri": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "conceptIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "conceptIds", "contentPath"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "conceptIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "contentPath": { "type": "string" },
          "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 30 }
        }
      }
    },
    "hintPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumLevel", "fullSolutionsAllowed", "minimumConfidence"],
      "properties": {
        "maximumLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
        "fullSolutionsAllowed": { "type": "boolean", "const": false },
        "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "manifestDigest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "signature": { "type": "string" }
      }
    }
  },
  "$defs": {
    "identifiedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      }
    }
  }
}
