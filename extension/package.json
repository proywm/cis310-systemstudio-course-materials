{
  "name": "systemstudio-cis310",
  "displayName": "SystemStudio CIS 310",
  "description": "Active Fall 2026 CIS 310 learning materials, the complete upstream Digital simulator, real Linux NASM and Windows MASM/Irvine toolchain routing, and a separate instruction trace tutor.",
  "version": "0.13.0",
  "private": true,
  "publisher": "probir-roy",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/proywm/cis310-systemstudio-course-materials.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "CIS 310",
    "digital logic",
    "processor",
    "circuit simulator",
    "Digital",
    "Irvine32",
    "MASM",
    "NASM",
    "assembly",
    "open textbook",
    "retrieval practice"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onView:systemstudioCis310.explorer",
    "onView:systemstudioCis310.materials",
    "onCustomEditor:systemstudioCis310.circuitPreview",
    "onCustomEditor:systemstudioCis310.fullDigitalEditor",
    "onLanguage:digital-circuit",
    "onLanguage:nasm",
    "onCommand:systemstudioCis310.setupDigital",
    "onCommand:systemstudioCis310.startTutorial",
    "onCommand:systemstudioCis310.openGettingStarted",
    "onCommand:systemstudioCis310.openStudentHelper",
    "onCommand:systemstudioCis310.openAiTutor",
    "onCommand:systemstudioCis310.openPreClassQuestion",
    "onCommand:systemstudioCis310.openPracticeCenter",
    "onCommand:systemstudioCis310.openGuidedLabs",
    "onCommand:systemstudioCis310.startQuickPractice",
    "onCommand:systemstudioCis310.reviewPractice",
    "onCommand:systemstudioCis310.openCanvas",
    "onCommand:systemstudioCis310.openCourseCalendar",
    "onCommand:systemstudioCis310.exportCourseCalendar",
    "onCommand:systemstudioCis310.openAcademicCalendar",
    "onCommand:systemstudioCis310.openSyllabus",
    "onCommand:systemstudioCis310.checkEnvironment",
    "onCommand:systemstudioCis310.openDigital",
    "onCommand:systemstudioCis310.createCircuit",
    "onCommand:systemstudioCis310.createAssignmentCircuit",
    "onCommand:systemstudioCis310.testCircuit",
    "onCommand:systemstudioCis310.exportSvg",
    "onCommand:systemstudioCis310.createStarterWorkspace",
    "onCommand:systemstudioCis310.browseLectures",
    "onCommand:systemstudioCis310.browseAssignments",
    "onCommand:systemstudioCis310.openMaterialsIndex",
    "onCommand:systemstudioCis310.createAssemblyLab",
    "onCommand:systemstudioCis310.checkAssemblyEnvironment",
    "onCommand:systemstudioCis310.openAssemblyLab",
    "onCommand:systemstudioCis310.buildRunAssembly",
    "onCommand:systemstudioCis310.runAssembly",
    "onCommand:systemstudioCis310.stepAssembly",
    "onCommand:systemstudioCis310.resetAssembly",
    "onCommand:systemstudioCis310.openMasmGuide"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Full Digital and real assembly execution are disabled until the workspace is trusted. Read-only course materials and learning practice remain available.",
      "restrictedConfigurations": [
        "systemstudioCis310.javaPath",
        "systemstudioCis310.testTimeoutSeconds",
        "systemstudioCis310.nasmPath",
        "systemstudioCis310.nasmLinkerPath",
        "systemstudioCis310.masmPath",
        "systemstudioCis310.masmLinkerPath",
        "systemstudioCis310.irvineRoot"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The Digital desktop simulator requires local filesystem access."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "systemstudioCis310.startTutorial",
        "title": "CIS 310: Start or Rerun Guided Tutorial",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openGettingStarted",
        "title": "CIS 310: Open Getting Started Walkthrough",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openStudentHelper",
        "title": "CIS 310: Open Local FAQ Chat",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openAiTutor",
        "title": "CIS 310: Open U-M Maizey AI Course Tutor",
        "category": "SystemStudio",
        "icon": "$(sparkle)"
      },
      {
        "command": "systemstudioCis310.openPreClassQuestion",
        "title": "CIS 310: Ask a Question Before Class",
        "category": "SystemStudio",
        "icon": "$(send)"
      },
      {
        "command": "systemstudioCis310.openPracticeCenter",
        "title": "CIS 310: Open Learning Dashboard",
        "category": "SystemStudio",
        "icon": "$(graph)"
      },
      {
        "command": "systemstudioCis310.openGuidedLabs",
        "title": "CIS 310: Open Hands-on Circuit and Assembly Labs",
        "category": "SystemStudio",
        "icon": "$(tools)"
      },
      {
        "command": "systemstudioCis310.startQuickPractice",
        "title": "CIS 310: Start 5-Question Practice",
        "category": "SystemStudio",
        "icon": "$(sparkle)"
      },
      {
        "command": "systemstudioCis310.reviewPractice",
        "title": "CIS 310: Review Due and Saved Questions",
        "category": "SystemStudio",
        "icon": "$(history)"
      },
      {
        "command": "systemstudioCis310.openCanvas",
        "title": "CIS 310: Open Fall 2026 Canvas Course",
        "category": "SystemStudio",
        "icon": "$(cloud)"
      },
      {
        "command": "systemstudioCis310.openCourseCalendar",
        "title": "CIS 310: Open Fall 2026 Course Calendar",
        "category": "SystemStudio",
        "icon": "$(calendar)"
      },
      {
        "command": "systemstudioCis310.exportCourseCalendar",
        "title": "CIS 310: Export Fall 2026 Calendar (.ics)",
        "category": "SystemStudio",
        "icon": "$(save-as)"
      },
      {
        "command": "systemstudioCis310.openAcademicCalendar",
        "title": "CIS 310: Open Official UM-Dearborn Academic Calendar",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openSyllabus",
        "title": "CIS 310: Open Fall 2026 Syllabus",
        "category": "SystemStudio",
        "icon": "$(file-pdf)"
      },
      {
        "command": "systemstudioCis310.setupDigital",
        "title": "CIS 310: Install/Verify Digital Simulator",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.checkEnvironment",
        "title": "CIS 310: Check Environment",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openDigital",
        "title": "CIS 310: Open Full Digital Simulator",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.createCircuit",
        "title": "CIS 310: Create a New Digital Circuit",
        "category": "SystemStudio",
        "icon": "$(new-file)"
      },
      {
        "command": "systemstudioCis310.createAssignmentCircuit",
        "title": "Create Assignment Circuit",
        "category": "SystemStudio",
        "icon": "$(new-file)"
      },
      {
        "command": "systemstudioCis310.testCircuit",
        "title": "CIS 310: Run Digital Circuit Tests",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.exportSvg",
        "title": "CIS 310: Preview Digital Circuit",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.createStarterWorkspace",
        "title": "CIS 310: Create Starter Workspace",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.browseLectures",
        "title": "CIS 310: Browse Presentations",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.browseAssignments",
        "title": "CIS 310: Browse Assignments",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openMaterialsIndex",
        "title": "CIS 310: Open Course-Material Guide",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.createAssemblyLab",
        "title": "CIS 310: Create Assembly Toolchain and Trace Examples",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.checkAssemblyEnvironment",
        "title": "CIS 310: Check Real Assembly Toolchains",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.openAssemblyLab",
        "title": "CIS 310: Open Instruction Trace Tutor",
        "category": "SystemStudio",
        "icon": "$(debug-alt)"
      },
      {
        "command": "systemstudioCis310.buildRunAssembly",
        "title": "CIS 310: Build and Run with Real Assembly Toolchain",
        "category": "SystemStudio",
        "icon": "$(run)"
      },
      {
        "command": "systemstudioCis310.runAssembly",
        "title": "CIS 310: Run in Instruction Trace Tutor",
        "category": "SystemStudio",
        "icon": "$(run)"
      },
      {
        "command": "systemstudioCis310.stepAssembly",
        "title": "CIS 310: Step in Instruction Trace Tutor",
        "category": "SystemStudio",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "systemstudioCis310.resetAssembly",
        "title": "CIS 310: Reset Instruction Trace Tutor",
        "category": "SystemStudio",
        "icon": "$(debug-restart)"
      },
      {
        "command": "systemstudioCis310.openMasmGuide",
        "title": "CIS 310: Open Assembly Compatibility Guide",
        "category": "SystemStudio"
      },
      {
        "command": "systemstudioCis310.refresh",
        "title": "Refresh",
        "category": "SystemStudio",
        "icon": "$(refresh)"
      },
      {
        "command": "systemstudioCis310.openDocumentation",
        "title": "CIS 310: Open Extension Documentation",
        "category": "SystemStudio"
      }
    ],
    "languages": [
      {
        "id": "digital-circuit",
        "aliases": [
          "Digital Circuit",
          "Digital"
        ],
        "extensions": [
          ".dig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nasm",
        "aliases": [
          "SystemStudio x86 Assembly",
          "x86 Assembly",
          "NASM",
          "MASM"
        ],
        "extensions": [
          ".asm"
        ],
        "configuration": "./assembly-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nasm",
        "scopeName": "source.nasm",
        "path": "./syntaxes/nasm.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "systemstudioCis310.fullDigitalEditor",
        "displayName": "Full Digital Simulator",
        "selector": [
          {
            "filenamePattern": "*.dig"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "systemstudioCis310.circuitPreview",
        "displayName": "SystemStudio Circuit Preview",
        "selector": [
          {
            "filenamePattern": "*.dig"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "systemstudioCis310",
          "title": "SystemStudio CIS 310",
          "icon": "media/chip.svg"
        }
      ]
    },
    "views": {
      "systemstudioCis310": [
        {
          "id": "systemstudioCis310.explorer",
          "name": "CIS 310 Home"
        },
        {
          "id": "systemstudioCis310.materials",
          "name": "Lessons and Assignments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "systemstudioCis310.explorer",
        "contents": "Start with one recommended learning action, then open details only when needed. Reading/video checkmarks, practice progress, and guided-lab checkmarks stay on this device and are not graded.\n[Prepare with book, video, and 3 questions](command:systemstudioCis310.openPracticeCenter)\n[Build a guided circuit or trace assembly](command:systemstudioCis310.openGuidedLabs)\n[Start 5-question practice](command:systemstudioCis310.startQuickPractice)\n[Open the U-M Maizey course tutor](command:systemstudioCis310.openAiTutor)\n[Ask a question before class](command:systemstudioCis310.openPreClassQuestion)\n[Open Fall 2026 Canvas](command:systemstudioCis310.openCanvas)\n[Open local FAQ chat](command:systemstudioCis310.openStudentHelper)\n[Start Guided Tutorial](command:systemstudioCis310.startTutorial)"
      },
      {
        "view": "systemstudioCis310.materials",
        "contents": "Active Fall 2026 lessons and assignments: every lecture has mapped open-book reading, an official author video, and readiness practice; the syllabus and 13 presentations are packaged PDFs, with three homework and three project references. Canvas is authoritative for current requirements and submission.\n[Prepare before class](command:systemstudioCis310.openPracticeCenter)\n[Open the syllabus PDF](command:systemstudioCis310.openSyllabus)\n[Open the course calendar](command:systemstudioCis310.openCourseCalendar)\n[Open material guide](command:systemstudioCis310.openMaterialsIndex)\n[Open Canvas to verify and submit](command:systemstudioCis310.openCanvas)"
      }
    ],
    "walkthroughs": [
      {
        "id": "systemstudioCis310.gettingStarted",
        "title": "Get Started with SystemStudio CIS 310",
        "description": "Learn the Fall 2026 read-watch-practice, Canvas, course-material, Full Digital, real assembly, trace-tutor, and help workflows. The clickable tutorial can be skipped or rerun.",
        "steps": [
          {
            "id": "guidedTour",
            "title": "Take the Clickable Guided Tour",
            "description": "Practice task-first choices based on recurring student concerns. Skip, resume, or rerun it without automatic installation.\n[Start or rerun the guided tutorial](command:systemstudioCis310.startTutorial)",
            "media": {
              "markdown": "media/tutorial/01-guided-tour.md"
            },
            "completionEvents": [
              "onCommand:systemstudioCis310.startTutorial"
            ]
          },
          {
            "id": "tools",
            "title": "Use the Grouped Student Workflow",
            "description": "Begin with the next Read → Watch → Try module, then expand practice, circuits, assembly, setup, or help only when needed.\n[Open SystemStudio](command:workbench.view.extension.systemstudioCis310)\n[Prepare before class](command:systemstudioCis310.openPracticeCenter)",
            "media": {
              "markdown": "media/tutorial/02-tools.md"
            },
            "completionEvents": [
              "onView:systemstudioCis310.explorer"
            ]
          },
          {
            "id": "materials",
            "title": "Read Before Class; Verify and Submit in Canvas",
            "description": "Use the mapped required open-book sections and official author videos before the 13 bundled lecture PDFs. The syllabus, calendar, presentations, three homework references, and three project references are packaged locally. Use Canvas for current requirements and submission.\n[Open the learning path](command:systemstudioCis310.openPracticeCenter)\n[Open the syllabus](command:systemstudioCis310.openSyllabus)\n[Open the course calendar](command:systemstudioCis310.openCourseCalendar)\n[Open the material guide](command:systemstudioCis310.openMaterialsIndex)\n[Open Fall 2026 Canvas](command:systemstudioCis310.openCanvas)",
            "media": {
              "markdown": "media/tutorial/03-materials.md"
            },
            "completionEvents": [
              "onView:systemstudioCis310.materials"
            ]
          },
          {
            "id": "circuits",
            "title": "Build Guided Circuits from Lecture Concepts",
            "description": "Start with the Lecture 2 half adder in the complete upstream Digital simulator, then continue through Boolean gates, selection, stored state, address decoding, and a small ALU slice. Each lab maps the reading/video, prediction, fresh circuit, simulation evidence, and explanation.\n[Open the hands-on lab center](command:systemstudioCis310.openGuidedLabs)\n[Create a new Digital circuit](command:systemstudioCis310.createCircuit)",
            "media": {
              "markdown": "media/tutorial/04-circuits.md"
            },
            "completionEvents": [
              "onCommand:systemstudioCis310.openGuidedLabs"
            ]
          },
          {
            "id": "assembly",
            "title": "Run Real Assembly and Visualize Instructions",
            "description": "Use an actual assembler/linker/executable when behavior must be exact. Use the separately labeled trace tutor only to predict and inspect registers, flags, memory, stack, and control flow.\n[Create the assembly examples](command:systemstudioCis310.createAssemblyLab)\n[Check real toolchains](command:systemstudioCis310.checkAssemblyEnvironment)\n[Open the hands-on lab center](command:systemstudioCis310.openGuidedLabs)\n[Open local FAQ chat](command:systemstudioCis310.openStudentHelper)",
            "media": {
              "markdown": "media/tutorial/05-assembly.md"
            },
            "completionEvents": [
              "onCommand:systemstudioCis310.createAssemblyLab"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "systemstudioCis310.refresh",
          "when": "view == systemstudioCis310.explorer",
          "group": "navigation"
        },
        {
          "command": "systemstudioCis310.openMaterialsIndex",
          "when": "view == systemstudioCis310.materials",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "systemstudioCis310.openDigital",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "systemstudio@0"
        },
        {
          "command": "systemstudioCis310.testCircuit",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "systemstudio@2"
        },
        {
          "command": "systemstudioCis310.exportSvg",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "systemstudio@3"
        },
        {
          "command": "systemstudioCis310.buildRunAssembly",
          "when": "resourceExtname == .asm",
          "group": "systemstudio@1"
        },
        {
          "command": "systemstudioCis310.openAssemblyLab",
          "when": "resourceExtname == .asm",
          "group": "systemstudio@2"
        }
      ],
      "view/item/context": [
        {
          "command": "systemstudioCis310.createAssignmentCircuit",
          "when": "view == systemstudioCis310.materials && viewItem == systemstudioCis310.assignmentWithCircuit",
          "group": "inline@1"
        }
      ],
      "editor/title": [
        {
          "command": "systemstudioCis310.openDigital",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "systemstudioCis310.testCircuit",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "systemstudioCis310.buildRunAssembly",
          "when": "resourceExtname == .asm",
          "group": "navigation@1"
        },
        {
          "command": "systemstudioCis310.openAssemblyLab",
          "when": "resourceExtname == .asm",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "SystemStudio CIS 310",
      "properties": {
        "systemstudioCis310.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to run the pinned Digital simulator. Use an absolute path if Java is not on PATH."
        },
        "systemstudioCis310.testTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Maximum duration for a headless Digital circuit test or SVG export."
        },
        "systemstudioCis310.nasmPath": {
          "type": "string",
          "default": "nasm",
          "description": "Actual NASM executable. On Debian/Ubuntu Linux the extension can install NASM privately when it is absent."
        },
        "systemstudioCis310.nasmLinkerPath": {
          "type": "string",
          "default": "ld",
          "description": "GNU linker used for the actual NASM ELF32 path."
        },
        "systemstudioCis310.masmPath": {
          "type": "string",
          "default": "ml.exe",
          "description": "Windows path to Microsoft MASM ml.exe. This exact toolchain is never emulated on non-Windows hosts."
        },
        "systemstudioCis310.masmLinkerPath": {
          "type": "string",
          "default": "link.exe",
          "description": "Windows path to the Microsoft linker paired with ml.exe."
        },
        "systemstudioCis310.irvineRoot": {
          "type": "string",
          "default": "C:\\Irvine",
          "description": "Windows directory containing the official Irvine32.inc, Irvine32.lib, Kernel32.lib, and User32.lib files."
        },
        "systemstudioCis310.promptToInstall": {
          "type": "boolean",
          "default": true,
          "description": "Prompt once to install the pinned Digital release when the extension first activates."
        },
        "systemstudioCis310.canvasCourseUrl": {
          "type": "string",
          "default": "https://canvas.umd.umich.edu/courses/552144",
          "description": "Authoritative Fall 2026 CIS 310 Canvas course URL used for deadlines, requirements, and submission."
        },
        "systemstudioCis310.maizeyTutorUrl": {
          "type": "string",
          "default": "https://canvas.umd.umich.edu/courses/552144",
          "description": "U-M Maizey course-tutor URL. Until the instructor copies the exact Maizey link, this opens the Fall 2026 Canvas course where the tutor is enabled."
        },
        "systemstudioCis310.preClassDiscussionUrl": {
          "type": "string",
          "default": "https://canvas.umd.umich.edu/courses/552144/discussion_topics",
          "description": "Canvas Questions Before Class discussion URL. Set this to the exact partially anonymous discussion topic after the instructor creates it."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const target of ['dist','course-packs']) fs.rmSync(target,{recursive:true,force:true})\"",
    "stage-course-pack": "node scripts/stage-course-pack.mjs",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check": "npm run stage-course-pack && npm run typecheck && npm test && npm run compile",
    "package": "npm run check && vsce package --out systemstudio-cis310.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.100.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "ws": "^8.21.0"
  }
}
