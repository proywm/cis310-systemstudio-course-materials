    "languages": [
      {
        "id": "digital-circuit",
        "aliases": [
          "Digital Circuit",
          "Digital"
        ],
        "extensions": [
          ".dig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "nasm",
        "aliases": [
          "SystemStudio x86 Assembly",
          "x86 Assembly",
          "NASM",
          "IA-32"
        ],
        "extensions": [
          ".asm"
        ],
        "configuration": "./assembly-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nasm",
        "scopeName": "source.nasm",
        "path": "./syntaxes/nasm.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "systemstudioCis310.fullDigitalEditor",
        "displayName": "Full Digital Simulator",
        "selector": [
          {
            "filenamePattern": "*.dig"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "systemstudioCis310.circuitPreview",
        "displayName": "SystemStudio Circuit Preview",
        "selector": [
          {
            "filenamePattern": "*.dig"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "systemstudioCis310",
          "title": "SystemStudio CIS 310",
          "icon": "media/chip.svg"
        }
      ]
    },
    "views": {
      "systemstudioCis310": [
        {
          "id": "systemstudioCis310.explorer",
          "name": "CIS 310 Home"
        },
        {
          "id": "systemstudioCis310.materials",
          "name": "Lessons and Assignments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "systemstudioCis310.explorer",
        "contents": "First let Orbit check the student-owned U-M Codex CLI, then run the guided course setup. The deterministic offline FAQ remains available if AI is unavailable. Detailed controls stay under Advanced Setup and Diagnostics. Reading/video checkmarks, practice progress, guided-lab checkmarks, coursework status, and self-evaluation stay on this device and are not instructor grades.\n[1. Configure or check U-M Codex](command:systemstudioCis310.configureAiAssistance)\n[2. Set up or repair my course environment](command:systemstudioCis310.setupCourseEnvironment)\n[Open the learning dashboard](command:systemstudioCis310.openPracticeCenter)\n[Open U-M Codex learning coach](command:systemstudioCis310.openAiTutor)\n[Open Coursework and Final Presentation](command:systemstudioCis310.openCourseworkCenter)\n[Open Fall 2026 Canvas](command:systemstudioCis310.openCanvas)\n[Start Guided Tutorial](command:systemstudioCis310.startTutorial)"
      },
      {
        "view": "systemstudioCis310.materials",
        "contents": "Active Fall 2026 lessons and assignments: every lecture has a primary accessible HTML page, mapped open-book reading, official author video, readiness practice, hands-on work where appropriate, and an optional visual PDF archive; three homework references, three processor milestones, and the cumulative 4-bit final-presentation guide are packaged. Canvas is authoritative for current requirements and submission.\n[Prepare before class](command:systemstudioCis310.openPracticeCenter)\n[Open the accessible syllabus](command:systemstudioCis310.openSyllabus)\n[Open the course calendar](command:systemstudioCis310.openCourseCalendar)\n[Open material guide](command:systemstudioCis310.openMaterialsIndex)\n[Open Canvas to verify and submit](command:systemstudioCis310.openCanvas)"
      }
    ],
    "walkthroughs": [
      {
        "id": "systemstudioCis310.gettingStarted",
        "title": "Get Started with SystemStudio CIS 310",
        "description": "Learn the Fall 2026 read-watch-practice, Canvas, course-material, Full Digital, real assembly, trace-tutor, and help workflows. The clickable tutorial can be skipped or rerun.",
        "steps": [
          {
            "id": "guidedTour",
            "title": "Take the Clickable Guided Tour",
            "description": "Practice task-first choices based on recurring student concerns. Skip, resume, or rerun it without automatic installation. Use the packaged visual guide for the first circuit/assembly tasks and Docker recovery.\n[Open the setup and first-task guide](command:systemstudioCis310.openSetupGuide)\n[Start or rerun the guided tutorial](command:systemstudioCis310.startTutorial)",
            "media": {
              "markdown": "media/tutorial/01-guided-tour.md"
            },
            "completionEvents": [
              "onCommand:systemstudioCis310.startTutorial"
            ]
          },
          {
            "id": "tools",
            "title": "Use the Grouped Student Workflow",
            "description": "Begin with the next Read → Watch → Try module, then expand practice, circuits, assembly, setup, or help only when needed.\n[Open SystemStudio](command:workbench.view.extension.systemstudioCis310)\n[Prepare before class](command:systemstudioCis310.openPracticeCenter)",
            "media": {
              "markdown": "media/tutorial/02-tools.md"
            },
            "completionEvents": [
              "onView:systemstudioCis310.explorer"
            ]
          },
          {
            "id": "materials",
            "title": "Read Before Class; Verify and Submit in Canvas",
            "description": "Begin with the 13 primary accessible HTML lectures, then use the mapped required open-book sections, official author videos, questions, and hands-on work. Optional visual PDF archives, the accessible syllabus, calendar, three homework references, three processor milestones, and the cumulative 4-bit final-presentation guide are packaged locally. Use Canvas for current requirements and submission.\n[Open the learning path](command:systemstudioCis310.openPracticeCenter)\n[Open the syllabus](command:systemstudioCis310.openSyllabus)\n[Open the course calendar](command:systemstudioCis310.openCourseCalendar)\n[Open the material guide](command:systemstudioCis310.openMaterialsIndex)\n[Open Fall 2026 Canvas](command:systemstudioCis310.openCanvas)",
            "media": {
              "markdown": "media/tutorial/03-materials.md"
            },
            "completionEvents": [
              "onView:systemstudioCis310.materials"
            ]
          },
          {
            "id": "circuits",
            "title": "Build Guided Circuits from Lecture Concepts",
            "description": "Start with the Lecture 2 half adder in the complete upstream Digital simulator, then continue through Boolean gates, selection, stored state, address decoding, and a small ALU slice. Each lab maps the reading/video, prediction, fresh circuit, simulation evidence, and explanation. The setup guide explains why Windows/macOS use Docker Desktop and how to recover when its engine is stopped.\n[Open the setup and first-task guide](command:systemstudioCis310.openSetupGuide)\n[Open the hands-on lab center](command:systemstudioCis310.openGuidedLabs)\n[Create a new Digital circuit](command:systemstudioCis310.createCircuit)",
            "media": {
              "markdown": "media/tutorial/04-circuits.md"
            },
            "completionEvents": [
              "onCommand:systemstudioCis310.openGuidedLabs"
            ]
          },
          {
            "id": "assembly",
            "title": "Run Real Assembly and Visualize Instructions",
            "description": "Use one Fall 2026 x86 path: actual NASM 32-bit plus the integrated GDB workbench. Build, run self-checks, set a label breakpoint, then inspect registers, EFLAGS, stack, memory, and Intel disassembly. The optional trace tutor remains conceptual practice only.\n[Create the NASM workspace](command:systemstudioCis310.createAssemblyLab)\n[Check the NASM environment](command:systemstudioCis310.checkAssemblyEnvironment)\n[Open the hands-on lab center](command:systemstudioCis310.openGuidedLabs)\n[Open local FAQ chat](command:systemstudioCis310.openStudentHelper)",
            "media": {
              "markdown": "media/tutorial/05-assembly.md"
            },
            "completionEvents": [
              "onCommand:systemstudioCis310.createAssemblyLab"
            ]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "systemstudioCis310.refresh",
          "when": "view == systemstudioCis310.explorer",
          "group": "navigation"
        },
        {
          "command": "systemstudioCis310.openMaterialsIndex",
          "when": "view == systemstudioCis310.materials",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "systemstudioCis310.openDigital",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "systemstudio@0"
        },
        {
          "command": "systemstudioCis310.testCircuit",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "systemstudio@2"
        },
        {
          "command": "systemstudioCis310.exportSvg",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "systemstudio@3"
        },
        {
          "command": "systemstudioCis310.buildRunAssembly",
          "when": "resourceExtname == .asm",
          "group": "systemstudio@1"
        },
        {
          "command": "systemstudioCis310.openNasmWorkbench",
          "when": "resourceExtname == .asm && isWorkspaceTrusted",
          "group": "systemstudio@2"
        },
        {
          "command": "systemstudioCis310.openAssemblyLab",
          "when": "resourceExtname == .asm",
          "group": "systemstudio@3"
        }
      ],
      "view/item/context": [
        {
          "command": "systemstudioCis310.createAssignmentCircuit",
          "when": "view == systemstudioCis310.materials && viewItem == systemstudioCis310.assignmentWithCircuit",
          "group": "inline@1"
        }
      ],
      "editor/title": [
        {
          "command": "systemstudioCis310.openDigital",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "systemstudioCis310.testCircuit",
          "when": "resourceExtname == .dig && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "systemstudioCis310.buildRunAssembly",
          "when": "resourceExtname == .asm",
          "group": "navigation@1"
        },
        {
          "command": "systemstudioCis310.openNasmWorkbench",
          "when": "resourceExtname == .asm && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "systemstudioCis310.openAssemblyLab",
          "when": "resourceExtname == .asm",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "SystemStudio CIS 310",
      "properties": {
        "systemstudioCis310.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to run the pinned Digital simulator. Use an absolute path if Java is not on PATH."
        },
        "systemstudioCis310.testTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 300,
          "description": "Maximum duration for a headless Digital circuit test or SVG export."
        },
        "systemstudioCis310.nasmPath": {
          "type": "string",
          "default": "nasm",
          "description": "Actual NASM executable. On Debian/Ubuntu Linux the extension can install NASM privately when it is absent."
        },
        "systemstudioCis310.nasmLinkerPath": {
          "type": "string",
          "default": "ld",
          "description": "GNU linker used for the actual NASM ELF32 path."
        },
        "systemstudioCis310.nasmGdbPath": {
          "type": "string",
          "default": "gdb",
          "description": "GDB executable used by the actual NASM workbench on x86 Linux."
        },
        "systemstudioCis310.nasmDockerPath": {
          "type": "string",
          "default": "docker",
          "description": "Docker executable used for the portable NASM/ELF32 course environment on Windows, macOS, or as a Linux fallback."
        },
        "systemstudioCis310.promptToInstall": {
          "type": "boolean",
          "default": true,
          "description": "Prompt once to install the pinned Digital release when the extension first activates."
        },
        "systemstudioCis310.canvasCourseUrl": {
          "type": "string",
          "default": "https://canvas.umd.umich.edu/courses/552144",
          "description": "Authoritative Fall 2026 CIS 310 Canvas course URL used for deadlines, requirements, and submission."
        },
        "systemstudioCis310.preClassDiscussionUrl": {
          "type": "string",
          "default": "https://canvas.umd.umich.edu/courses/552144/discussion_topics",
          "description": "Canvas Questions Before Class discussion URL. Set this to the exact partially anonymous discussion topic after the instructor creates it."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs'); for (const target of ['dist','course-packs']) fs.rmSync(target,{recursive:true,force:true})\"",
    "export:canvas": "tsx scripts/export-canvas-lessons.ts",
    "export:preflights": "tsx scripts/export-circuit-preflights.ts",
    "stage-course-pack": "node scripts/stage-course-pack.mjs",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
