{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SystemStudio NASM IA-32 Assembly",
  "scopeName": "source.nasm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#directives" },
    { "include": "#registers" },
    { "include": "#instructions" },
    { "match": "^[A-Za-z_.$?][A-Za-z0-9_.$?#@~]*:", "name": "entity.name.function.label.nasm" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "begin": ";", "end": "$", "name": "comment.line.semicolon.nasm" }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.nasm" },
        { "begin": "'", "end": "'", "name": "string.quoted.single.nasm" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b(?:0x[0-9A-Fa-f]+|[0-9A-Fa-f]+h|0b[01]+|[01]+b|[0-9]+)\\b", "name": "constant.numeric.nasm" }
      ]
    },
    "directives": {
      "patterns": [
        { "match": "(?i)(?:\\.386|\\.model|\\.stack|\\.data|\\.code|\\b(?:bits|section|segment|global|extern|include|title|proc|endp|end|equ|byte|word|dword|db|dw|dd|dup|offset|ptr)\\b)", "name": "keyword.control.directive.nasm" }
      ]
    },
    "registers": {
      "patterns": [
        { "match": "(?i)\\b(?:e(?:ax|bx|cx|dx|si|di|bp|sp|ip)|(?:ax|bx|cx|dx|si|di|bp|sp)|[abcd][lh])\\b", "name": "variable.language.register.nasm" }
      ]
    },
    "instructions": {
      "patterns": [
        { "match": "(?i)\\b(?:mov|movzx|movsx|lea|xchg|push|pop|pushad|popad|pushfd|popfd|add|adc|sub|sbb|inc|dec|neg|imul|mul|idiv|div|and|or|xor|not|shl|sal|shr|sar|cmp|test|jmp|j[a-z]+|loop|call|ret|leave|invoke|clc|stc|cmc|cdq|int|exit|hlt|nop)\\b", "name": "keyword.operator.instruction.nasm" }
      ]
    }
  }
}
